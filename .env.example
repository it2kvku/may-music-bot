# Copy to .env for local use. On Botkeep, use Environment / Secrets instead.
# Never commit your filled .env file.
DISCORD_TOKEN=
# Application ID from Discord Developer Portal; needed by npm run register.
DISCORD_CLIENT_ID=
# Optional: a test server ID gives fast guild-only slash command registration.
# Leave empty for global commands.
DISCORD_GUILD_ID=
AUTO_REGISTER_COMMANDS=true

# Host and port ONLY, without http://, https://, ws:// or a trailing path.
# For Docker Compose this value is overridden with lavalink:2333.
LAVALINK_URL=localhost:2333
LAVALINK_PASSWORD=replace-with-a-long-random-password
LAVALINK_SECURE=false
LAVALINK_NAME=primary

DEFAULT_VOLUME=60
DEFAULT_AUTOPLAY=true
MAX_QUEUE_SIZE=500
MAX_PLAYLIST_SIZE=100
IDLE_TIMEOUT_SECONDS=180
EMPTY_CHANNEL_TIMEOUT_SECONDS=60
# Optional role ID restricting playback controls. Server managers retain access.
DJ_ROLE_ID=
COMMAND_COOLDOWN_MS=1500
DATA_DIR=./data

ENABLE_HEALTH_SERVER=true
# Botkeep may supply SERVER_PORT. Use the port assigned in its panel.
PORT=3000
NODE_ENV=production

# Only the Lavalink service needs Spotify application credentials.
# Create them at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Optional; see docs/BOTKEEP.md before enabling a custom token endpoint.
# SPOTIFY_TOKEN_ENDPOINT=
